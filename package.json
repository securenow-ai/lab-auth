{
  "name": "@securenow-ai/lab-auth",
  "version": "1.0.0",
  "private": true,
  "description": "An open authentication lab for learning threat modeling and defense.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "test": "node --test --test-concurrency=1",
    "check": "node --check src/app.js && node --check src/server.js && node --test --test-concurrency=1"
  },
  "dependencies": {
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "google-auth-library": "^10.4.1",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "securenow": "8.12.2"
  }
}
