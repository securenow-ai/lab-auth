{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Isolated SecureNow authentication lab: EC2, private PostgreSQL, HTTPS, SSM, encrypted artifacts and backups.",
  "Parameters": {
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id"
    },
    "SubnetId": {
      "Type": "AWS::EC2::Subnet::Id"
    },
    "HostedZoneId": {
      "Type": "String"
    },
    "Domain": {
      "Type": "String",
      "Default": "lab-auth.labs.securenow.ai",
      "AllowedPattern": "[a-z0-9.-]+"
    },
    "ImageId": {
      "Type": "AWS::SSM::Parameter::Value<AWS::EC2::Image::Id>",
      "Default": "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64"
    },
    "InstanceType": {
      "Type": "String",
      "Default": "t3.small",
      "AllowedValues": [
        "t3.small",
        "t3.medium"
      ]
    }
  },
  "Resources": {
    "Artifacts": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "lab-auth-${AWS::AccountId}-${AWS::Region}"
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "Backups",
              "Prefix": "backups/",
              "Status": "Enabled",
              "ExpirationInDays": 7,
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 7
              }
            },
            {
              "Id": "OldReleases",
              "Prefix": "releases/",
              "Status": "Enabled",
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 14
              }
            }
          ]
        }
      }
    },
    "ArtifactPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "Artifacts"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "Artifacts",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${Artifacts.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "Firewall": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Auth lab HTTPS only; administration via SSM",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "CidrIp": "0.0.0.0/0"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": "lab-auth"
          }
        ]
      }
    },
    "Role": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": [
                  "ec2.amazonaws.com"
                ]
              },
              "Action": [
                "sts:AssumeRole"
              ]
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
        ],
        "Policies": [
          {
            "PolicyName": "AuthLabArtifactsAndRuntime",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${Artifacts.Arn}/releases/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:PutObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${Artifacts.Arn}/backups/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:secretsmanager:${AWS::Region}:${AWS::AccountId}:secret:lab-auth/runtime-*"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "Profile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "Roles": [
          {
            "Ref": "Role"
          }
        ]
      }
    },
    "Server": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": {
          "Ref": "ImageId"
        },
        "InstanceType": {
          "Ref": "InstanceType"
        },
        "IamInstanceProfile": {
          "Ref": "Profile"
        },
        "SubnetId": {
          "Ref": "SubnetId"
        },
        "SecurityGroupIds": [
          {
            "Ref": "Firewall"
          }
        ],
        "MetadataOptions": {
          "HttpTokens": "required",
          "HttpEndpoint": "enabled",
          "HttpPutResponseHopLimit": 1
        },
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/xvda",
            "Ebs": {
              "VolumeSize": 30,
              "VolumeType": "gp3",
              "Encrypted": true,
              "DeleteOnTermination": true
            }
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": "lab-auth"
          },
          {
            "Key": "Project",
            "Value": "securenow-auth-lab"
          }
        ],
        "UserData": {
          "Fn::Base64": {
            "Fn::Sub": "#!/bin/bash\nexport REGION=\"${AWS::Region}\"\nexport ARTIFACT_BUCKET=\"${Artifacts}\"\nexport APP_DOMAIN=\"${Domain}\"\nset -euo pipefail\numask 077\n# REGION, ARTIFACT_BUCKET and APP_DOMAIN are supplied by CloudFormation.\ndnf install -y docker awscli2 python3\nsystemctl enable --now docker\ninstall -d -m 755 /usr/local/lib/docker/cli-plugins\ncurl --fail --silent --show-error --location https://github.com/docker/compose/releases/download/v2.39.4/docker-compose-linux-x86_64 -o /usr/local/lib/docker/cli-plugins/docker-compose\nchmod 755 /usr/local/lib/docker/cli-plugins/docker-compose\ninstall -d -m 700 /etc/lab-auth\ninstall -d -m 755 /opt/lab-auth\nprintf 'REGION=%s\\nARTIFACT_BUCKET=%s\\nAPP_DOMAIN=%s\\n' \"$REGION\" \"$ARTIFACT_BUCKET\" \"$APP_DOMAIN\" > /etc/lab-auth/deployment.env\nfor attempt in $(seq 1 180); do\n  if aws s3 cp \"s3://$ARTIFACT_BUCKET/releases/source.tar.gz\" /opt/lab-auth/source.tar.gz --region \"$REGION\" --only-show-errors; then break; fi\n  sleep 5\ndone\ntar xzf /opt/lab-auth/source.tar.gz -C /opt/lab-auth\nchmod 700 /opt/lab-auth/infra/update.sh /opt/lab-auth/infra/backup.sh\n/opt/lab-auth/infra/update.sh\ncat > /etc/systemd/system/lab-auth-backup.service <<'UNIT'\n[Unit]\nDescription=Back up Auth Lab PostgreSQL to private encrypted S3\nAfter=docker.service\n[Service]\nType=oneshot\nExecStart=/opt/lab-auth/infra/backup.sh\nUNIT\ncat > /etc/systemd/system/lab-auth-backup.timer <<'UNIT'\n[Unit]\nDescription=Daily Auth Lab database backup\n[Timer]\nOnCalendar=*-*-* 03:10:00 UTC\nRandomizedDelaySec=600\nPersistent=true\n[Install]\nWantedBy=timers.target\nUNIT\nsystemctl daemon-reload\nsystemctl enable --now lab-auth-backup.timer\ntouch /etc/lab-auth/bootstrap-complete\necho 'AUTH_LAB_BOOTSTRAP_COMPLETE'\n"
          }
        }
      }
    },
    "Address": {
      "Type": "AWS::EC2::EIP",
      "Properties": {
        "Domain": "vpc",
        "Tags": [
          {
            "Key": "Name",
            "Value": "lab-auth"
          }
        ]
      }
    },
    "AddressAssociation": {
      "Type": "AWS::EC2::EIPAssociation",
      "Properties": {
        "AllocationId": {
          "Fn::GetAtt": [
            "Address",
            "AllocationId"
          ]
        },
        "InstanceId": {
          "Ref": "Server"
        }
      }
    },
    "DNS": {
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "HostedZoneId": {
          "Ref": "HostedZoneId"
        },
        "Name": {
          "Ref": "Domain"
        },
        "Type": "A",
        "TTL": "60",
        "ResourceRecords": [
          {
            "Ref": "Address"
          }
        ]
      }
    }
  },
  "Outputs": {
    "InstanceId": {
      "Value": {
        "Ref": "Server"
      }
    },
    "PublicIp": {
      "Value": {
        "Ref": "Address"
      }
    },
    "ArtifactBucket": {
      "Value": {
        "Ref": "Artifacts"
      }
    },
    "AppUrl": {
      "Value": {
        "Fn::Sub": "https://${Domain}"
      }
    },
    "BackupPrefix": {
      "Value": {
        "Fn::Sub": "s3://${Artifacts}/backups/"
      }
    }
  }
}
