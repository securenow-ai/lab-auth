# Copy locally to .env; generate independent secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://lab_auth:local_password@localhost:5432/lab_auth
# Docker Compose database password. Generate hexadecimal text: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
POSTGRES_PASSWORD=replace-with-64-random-hex-characters
# Use 1 only when an isolated Docker network allows Caddy as the sole app ingress.
TRUST_PROXY=loopback
SESSION_SECRET=replace-with-at-least-32-random-characters
AUDIT_HMAC_SECRET=replace-with-a-different-random-secret

# Optional. Configure a Web application client in Google Auth Platform.
# Authorized redirect: APP_ORIGIN/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# One-time admin bootstrap only. No default credentials are shipped.
# Set these only while running npm run seed; remove ADMIN_PASSWORD afterward.
ADMIN_EMAIL=
ADMIN_NAME=Lab administrator
ADMIN_PASSWORD=

# Integration tests require a separate disposable PostgreSQL database.
# TEST_DATABASE_URL=postgresql://lab_auth:local_password@localhost:5432/lab_auth_test
